# --- Database (Neon) ---
# Pooled connection string. The Neon integration on Vercel sets this for you.
DATABASE_URL=postgres://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Direct (unpooled) connection, used only by `npm run db:migrate`. Also set by the Neon integration.
DATABASE_URL_UNPOOLED=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Password for /admin, and a long random string that signs the admin session cookie
ADMIN_PASSWORD=
SESSION_SECRET=
# Vercel Cron sends this as a bearer token to the scheduled-job routes
CRON_SECRET=

# --- Sign-in ---
# Guests and hosts sign in before anything else, with a mobile number (one-time code by SMS) or Google.
# Set up at least one of the two. With neither, the app falls back to joining with just a name.

# One-time codes by SMS. OTP_PROVIDER is one of:
#   msg91    MSG91 (India). Needs MSG91_AUTH_KEY and MSG91_TEMPLATE_ID (a DLT-approved OTP template).
#   webhook  The app POSTs {"phone","code","message"} as JSON to OTP_WEBHOOK_URL; use it for any other SMS or WhatsApp sender.
#   log      Prints the code to the server log. Local development only; ignored in production.
OTP_PROVIDER=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
OTP_WEBHOOK_URL=
OTP_WEBHOOK_SECRET=
# Most codes the app will send in 24 hours, as a guard against a runaway SMS bill
OTP_DAILY_CAP=3000

# Google sign-in. Redirect URI to register with Google: <NEXT_PUBLIC_APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI (all model names live here; code reads them through src/lib/ai) ---
ANTHROPIC_API_KEY=
AI_READ_MODEL=claude-haiku-5-5
AI_JUDGE_MODEL=claude-sonnet-5-5
AI_VOCAB_MODEL=claude-haiku-5-5
AI_READ_EFFORT=medium
AI_JUDGE_EFFORT=medium
# Optional price override, USD per million tokens: {"model-id":[input,output]}
AI_PRICES=

# --- Embeddings (Marqo-FashionSigLIP) ---
# browser = guests' phones compute the vectors (zero server cost), server = always server-side
NEXT_PUBLIC_EMBED_MODE=browser
NEXT_PUBLIC_EMBED_MODEL=Marqo/marqo-fashionSigLIP
NEXT_PUBLIC_EMBED_DTYPE=q8
# Optional: URL of the small embedding server (scripts/embed-server.ts). If empty, the app
# runs the model in-process when the browser could not.
EMBED_URL=
EMBED_SECRET=
