# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings > API > JWT secret (legacy HS256 secret). Used to mint guest tokens for row-level security.
SUPABASE_JWT_SECRET=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated emails allowed into /admin (magic-link login)
ADMIN_EMAILS=you@example.com
# Shared secret for the scheduled-job routes (also stored in the private_config table)
CRON_SECRET=

# --- AI (all model names live here; code reads them through src/lib/ai) ---
ANTHROPIC_API_KEY=
AI_READ_MODEL=claude-haiku-5-5
AI_JUDGE_MODEL=claude-sonnet-5-5
AI_VOCAB_MODEL=claude-haiku-5-5
AI_READ_EFFORT=low
AI_JUDGE_EFFORT=medium
# Optional price override, USD per million tokens: {"model-id":[input,output]}
AI_PRICES=

# --- Embeddings (Marqo-FashionSigLIP) ---
# browser = guests' phones compute the vectors (zero server cost), server = always server-side
NEXT_PUBLIC_EMBED_MODE=browser
NEXT_PUBLIC_EMBED_MODEL=Marqo/marqo-fashionSigLIP
NEXT_PUBLIC_EMBED_DTYPE=q8
# Optional: URL of the small embedding server (scripts/embed-server.ts). If empty, the app
# runs the model in-process when the browser could not.
EMBED_URL=
EMBED_SECRET=
